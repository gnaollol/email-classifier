{
    "manifest_version": 3,
    "name": "Email Classifier",
    "version": "1.1.0",
    "description": "Reduces corporate jargon in emails",
    "permissions": [
        "storage",
        "identity",
        "offscreen"
    ],
    "host_permissions": [
        "https://mail.google.com/*",
        "https://gmail.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "521336956302-5har6fncfapiradfltlm8lg1sgd09m5d.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/gmail.readonly"
        ]
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "classifier.js",
                "content.js"
            ]
        }
    ]
}